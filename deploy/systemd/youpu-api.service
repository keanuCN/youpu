[Unit]
Description=Youpu API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/youpu/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/opt/youpu/apps/api/.env
ExecStart=/usr/bin/node /opt/youpu/apps/api/dist/main.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
