# 复制为 .env 后使用：docker compose 本地基础设施
# （apps/api 与 apps/web 各自还有独立的 .env.example）

POSTGRES_USER=youpu
POSTGRES_PASSWORD=youpu_dev_password
POSTGRES_DB=youpu

# Redis 宿主机端口；容器内端口固定为 6379，本机冲突时可改成 6380 等
REDIS_HOST_PORT=6379

# Elasticsearch 8.x 单节点
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Umami 自托管分析（首次启动自动建表）
UMAMI_APP_SECRET=change_me_umami_secret
