# 复制为 apps/api/.env
# 本地默认值与 docker/compose.yml 一致，起完 infra:up 即可直接跑

DATABASE_URL=postgresql://youpu:youpu_dev_password@localhost:5432/youpu
REDIS_URL=redis://localhost:6379
# 默认 infra:up 不启动 Elasticsearch；启用 full profile 后再取消注释
# ES_NODE=http://localhost:9200
ES_INDEX_PREFIX=youpu

PORT=3001
# 逗号分隔的允许来源（web 端）
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# 后台迁移期旧管理令牌（至少 16 位；不要提交真实值）。账号登录不依赖它；正式环境可不配置。
ADMIN_TOKEN=replace-with-a-long-random-token
ADMIN_ROLE=admin
# 旧令牌操作的回退审计账号 UUID；账号登录会优先记录真实登录账号。
ADMIN_ACTOR_ID=

# 本地 M3 账号访问令牌签名密钥；上线前替换为独立随机值，不要提交真实密钥
AUTH_SECRET=youpu-local-auth-secret-change-me

# 邮箱验证码投递；开发和生产环境都必须完整配置真实 SMTP
# Resend 示例：smtp.resend.com / 587 / 用户名 resend / 密码为 API Key
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# 数据目录（seed 导入源），相对 monorepo 根
DATA_DIR=../../data

# 火山引擎 TOS 图片上传。六项配置需全部填写或全部留空。
# Access Key 仅在 API 服务端配置；授权建议仅限目标存储桶的 product-images/* PutObject。
TOS_REGION=
TOS_BUCKET=
TOS_ENDPOINT=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_PUBLIC_BASE_URL=
