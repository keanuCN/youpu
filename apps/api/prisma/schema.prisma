// 有谱数据库 schema —— 与《有谱-数据库表结构设计.md》v1.1 一一对应
// 迁移工具：Prisma（schema 即 TS 类型，前后端共享）
// 注意：ltree / inet / 分区表 / 部分唯一索引在 Prisma schema 中表达受限，
//       以 prisma/migrations 下手工 SQL 为准（PG16 不支持分区表 identity 列，event 用显式 sequence）。

generator client {
  provider = "prisma-client-js"
  // 显式输出到仓库内固定路径：pnpm 的 symlink 布局下默认解析会命中 @prisma/client 的 stub
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 品类与产品域 ───────────────────────────

model Category {
  id              String                @id @db.Uuid
  parentId        String?               @map("parent_id") @db.Uuid
  slug            String                @unique
  name            String
  level           Int                   @db.SmallInt
  path            Unsupported("ltree")?
  coverUrl        String?               @map("cover_url")
  sortOrder       Int                   @default(0) @map("sort_order")
  specSchema      Json?                 @map("spec_schema")
  recommendConfig Json?                 @map("recommend_config")
  status          String                @default("active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent         Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]       @relation("CategoryTree")
  products       Product[]
  rankings       Ranking[]
  compareHistory CompareHistory[]

  @@map("category")
}

model Brand {
  id          String   @id @db.Uuid
  slug        String   @unique
  name        String
  nameCn      String?  @map("name_cn")
  country     String?
  logoUrl     String?  @map("logo_url")
  officialUrl String?  @map("official_url")
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products    Product[]
  dataSources DataSource[]

  @@map("brand")
}

model Product {
  id              String    @id @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  slug            String    @unique
  model           String
  year            Int       @db.SmallInt
  title           String
  oneLiner        String?   @map("one_liner")
  priceMin        Decimal?  @map("price_min") @db.Decimal(10, 2)
  priceMax        Decimal?  @map("price_max") @db.Decimal(10, 2)
  priceCurrency   String    @default("CNY") @map("price_currency") @db.Char(3)
  coverUrl        String?   @map("cover_url")
  specs           Json      @default("{}")
  /// 编辑分项评分（键与 spec_schema.rating_dimensions 对齐）；综合指数由其权重实时算出，不落库
  editorialScores Json?     @map("editorial_scores")
  ratingOverall   Decimal?  @map("rating_overall") @db.Decimal(3, 2)
  ratingCount     Int       @default(0) @map("rating_count")
  ratingSub       Json?     @map("rating_sub")
  favoriteCount   Int       @default(0) @map("favorite_count")
  status          String    @default("draft")
  dataSource      String?   @map("data_source")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     Category       @relation(fields: [categoryId], references: [id])
  brand        Brand          @relation(fields: [brandId], references: [id])
  images       ProductImage[]
  stat         ProductStat?
  ratings      Rating[]
  favorites    Favorite[]
  rankEntries  RankEntry[]
  rankingVotes RankingVote[]

  @@unique([brandId, model, year])
  @@index([categoryId, status, year(sort: Desc)])
  @@map("product")
}

model ProductImport {
  id             String    @id @db.Uuid
  kind           String
  slug           String
  product        Json
  changes        Json      @default("[]")
  ignoredChanges Json      @default("[]") @map("ignored_changes")
  originUrl      String?   @map("origin_url")
  status         String    @default("pending")
  submittedBy    String?   @map("submitted_by") @db.Uuid
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)

  submitter Account? @relation("ProductImportSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer  Account? @relation("ProductImportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([slug, status])
  @@map("product_import")
}

model ProductImage {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  kind      String
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  alt       String?
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_image")
}

model ProductStat {
  productId String   @id @map("product_id") @db.Uuid
  viewTotal Int      @default(0) @map("view_total")
  view7d    Int      @default(0) @map("view_7d")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_stat")
}

// ─────────────────────────── 用户与认证域 ───────────────────────────

model Account {
  id              String    @id @db.Uuid
  email           String?   @unique
  phone           String?   @unique
  nickname        String
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  avatarUrl       String?   @map("avatar_url")
  riderProfile    Json?     @map("rider_profile")
  role            String    @default("user")
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ratings                 Rating[]
  ratingVotes             RatingVote[]
  replies                 RatingReply[]       @relation("ReplyAuthor")
  repliesTo               RatingReply[]       @relation("ReplyTarget")
  favorites               Favorite[]
  compareHistory          CompareHistory[]
  recommendationRuns      RecommendationRun[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]      @relation("NotificationOwner")
  actedIn                 Notification[]      @relation("NotificationActor")
  reportsMade             Report[]            @relation("Reporter")
  reportsHandled          Report[]            @relation("ReportHandler")
  rankingVotes            RankingVote[]
  auditLogs               AuditLog[]
  configRules             ConfigRule[]
  submittedProductImports ProductImport[]     @relation("ProductImportSubmitter")
  reviewedProductImports  ProductImport[]     @relation("ProductImportReviewer")

  @@map("account")
}

model RefreshToken {
  id        String               @id @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  tokenHash String               @unique @map("token_hash")
  userAgent String?              @map("user_agent")
  ip        Unsupported("inet")?
  expiresAt DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model AuditLog {
  id        BigInt               @id @default(autoincrement())
  actorId   String               @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?              @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  ip        Unsupported("inet")?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Account @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

// ─────────────────────────── 评分评论域 ───────────────────────────

model Rating {
  id                  String    @id @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  overall             Decimal   @db.Decimal(2, 1)
  sub                 Json      @default("{}")
  content             String?
  images              Json      @default("[]")
  riderProfile        Json      @default("{}") @map("rider_profile")
  source              String    @default("user")
  status              String    @default("published")
  moderationRisk      String    @default("clear") @map("moderation_risk")
  moderationReasons   Json      @default("[]") @map("moderation_reasons")
  moderationCheckedAt DateTime? @map("moderation_checked_at") @db.Timestamptz(6)
  helpfulCount        Int       @default(0) @map("helpful_count")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  votes   RatingVote[]
  replies RatingReply[]

  @@unique([productId, accountId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@map("rating")
}

model RatingVote {
  ratingId  String   @map("rating_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rating  Rating  @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([ratingId, accountId])
  @@map("rating_vote")
}

model RatingReply {
  id                  String    @id @db.Uuid
  ratingId            String    @map("rating_id") @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  replyTo             String?   @map("reply_to") @db.Uuid
  content             String
  status              String    @default("published")
  moderationRisk      String    @default("clear") @map("moderation_risk")
  moderationReasons   Json      @default("[]") @map("moderation_reasons")
  moderationCheckedAt DateTime? @map("moderation_checked_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  rating  Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  account Account  @relation("ReplyAuthor", fields: [accountId], references: [id], onDelete: Cascade)
  target  Account? @relation("ReplyTarget", fields: [replyTo], references: [id])

  @@index([ratingId, createdAt])
  @@index([ratingId, status, createdAt])
  @@map("rating_reply")
}

model Report {
  id         String    @id @db.Uuid
  targetType String    @map("target_type")
  targetId   String    @map("target_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  reason     String
  note       String?
  status     String    @default("open")
  handledBy  String?   @map("handled_by") @db.Uuid
  handledAt  DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter Account  @relation("Reporter", fields: [reporterId], references: [id])
  handler  Account? @relation("ReportHandler", fields: [handledBy], references: [id])

  @@unique([targetType, targetId, reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@map("report")
}

// ─────────────────────────── 留存域 ───────────────────────────

model Favorite {
  accountId String   @map("account_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([accountId, productId])
  @@index([productId])
  @@map("favorite")
}

model CompareHistory {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  productIds String[] @map("product_ids") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@map("compare_history")
}

model RecommendationRun {
  id           String   @id @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  categorySlug String   @map("category_slug")
  answers      Json
  picks        Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@map("recommendation_run")
}

model Notification {
  id            BigInt    @id @default(autoincrement())
  accountId     String    @map("account_id") @db.Uuid
  type          String
  actorId       String?   @map("actor_id") @db.Uuid
  targetType    String?   @map("target_type")
  targetId      String?   @map("target_id") @db.Uuid
  sourceEventId BigInt?   @unique @map("source_event_id")
  payload       Json      @default("{}")
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account  @relation("NotificationOwner", fields: [accountId], references: [id], onDelete: Cascade)
  actor   Account? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([accountId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

// ─────────────────────────── 榜单域 ───────────────────────────

model Ranking {
  id          String    @id @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  slug        String    @unique
  title       String
  description String?
  method      String
  season      String?
  coverUrl    String?   @map("cover_url")
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category      @relation(fields: [categoryId], references: [id])
  entries  RankEntry[]
  votes    RankingVote[]

  @@map("ranking")
}

model RankEntry {
  rankingId String   @map("ranking_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  position  Int      @db.SmallInt
  score     Decimal? @db.Decimal(6, 2)
  note      String?

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([rankingId, productId])
  @@map("rank_entry")
}

model RankingVote {
  rankingId String   @map("ranking_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([rankingId, accountId, productId])
  @@map("ranking_vote")
}

// ─────────────────────────── 数据管线域 ───────────────────────────

model DataSource {
  id          String   @id @db.Uuid
  brandId     String?  @map("brand_id") @db.Uuid
  originUrl   String   @map("origin_url")
  kind        String
  snapshotUrl String?  @map("snapshot_url")
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz(6)

  brand Brand? @relation(fields: [brandId], references: [id])

  @@map("data_source")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  aggregate   String
  aggregateId String    @map("aggregate_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts    Int       @default(0) @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("outbox_event")
}

model ConfigRule {
  id        String   @id @db.Uuid
  kind      String
  key       String
  payload   Json
  active    Boolean  @default(true)
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  editor Account? @relation(fields: [updatedBy], references: [id])

  @@unique([kind, key, version])
  @@map("config_rule")
}

// ─────────────────────────── 埋点事件（分区表） ───────────────────────────

model Event {
  id        BigInt   @default(autoincrement())
  anonId    String   @map("anon_id") @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  name      String
  path      String?
  props     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([name, createdAt(sort: Desc)])
  @@index([anonId, createdAt(sort: Desc)])
  @@map("event")
}
