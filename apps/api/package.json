{
  "name": "@youpu/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:health": "node --import tsx --test src/health/health-check.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "tsx src/seed/run.ts",
    "seed:product": "tsx src/seed/sync-one-product.ts",
    "validate:data": "tsx src/seed/validate.ts",
    "es:reindex": "tsx src/search/reindex.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "@youpu/schema": "workspace:*",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
