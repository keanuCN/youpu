# 复制为 apps/web/.env.local
NEXT_PUBLIC_API_BASE=http://localhost:3001
# 同源 Nginx 部署时启用；浏览器随当前入口访问 API，服务端仍使用上方绝对地址。
NEXT_PUBLIC_API_SAME_ORIGIN=false

# 内容来源：pack（默认，本地内容包）| api（优先请求 API，失败自动回退内容包）
NEXT_PUBLIC_CONTENT_SOURCE=pack

# 站点根域名（canonical / sitemap / 结构化数据用），上线时改为正式域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 正式站：SITE_URL 和 API_BASE 均使用 https://youpu.asia，BASE_PATH 留空。
# 同一源码部署多个入口时，为每个入口指定独立构建目录。
NEXT_PUBLIC_BASE_PATH=
# 可选：配置 https://img.youpu.asia 后，将自有 TOS 商品图路径切到图片 CDN；留空则直接读 TOS。
NEXT_PUBLIC_TOS_CDN_BASE_URL=
# NEXT_DIST_DIR=.next-youpu-domain
